# Kopyahin bilang Database/.env, tapos palitan ang mga placeholder sa totoong values.
# Huwag i-commit o i-share ang Database/.env dahil may private credentials iyon.

# MongoDB Atlas connection URI na ginagamit lang ng backend.
# I-URL-encode ang special characters sa database password bago ilagay rito.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Secret na ginagamit sa pagpirma at pag-verify ng login tokens.
# Gumamit ng sariling random value na hindi bababa sa 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Port na pakikinggan ng backend; 5000 ang default para sa local development.
PORT=5000

# Mga web origin na pinapayagan tumawag sa API, pinaghiwalay ng comma.
# Sa production, palitan ito ng eksaktong domain ng deployed web app.
CLIENT_ORIGINS=http://localhost:8081,http://localhost:8084
